# Copy to .env.local to override. Vite also loads:
#   .env.development  → npm run dev  (localhost backend)
#   .env.production   → npm run build (Modal backend)

# Full API prefix or origin are both accepted.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Vite dev proxy target (defaults to localhost:8000 in development).
VITE_BACKEND_PROXY_TARGET=http://localhost:8000

# Production / optional fallback (never used during npm run dev).
# VITE_BACKEND_FALLBACK_URL=https://sih-oil-spill-26143-backend.onrender.com

# Talk to the backend origin directly instead of the Vite /api proxy.
# Requires CORS to allow http://localhost:5173.
# VITE_BACKEND_DIRECT=true

# Opt in to the Modal ML demo scene during local development (uses ML credits).
# VITE_USE_MODAL_ML=true
# VITE_ML_BASE_URL=/ml-api
